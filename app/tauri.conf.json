{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "capture-rs",
  "version": "0.2.0",
  "identifier": "io.github.ssiuuk.capture-rs",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "toolbox",
        "title": "capture-rs",
        "url": "toolbox.html",
        "width": 600,
        "height": 226,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: snapshot: http://snapshot.localhost library: http://library.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "licenseFile": "../LICENSE",
    "shortDescription": "Screen capture toolbox",
    "category": "Utility"
  }
}
